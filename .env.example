# API backend base URL (e.g., https://api.flowlee.com)
VITE_API_BASE_URL=https://api.example.com

# Auth0 tenant URL
VITE_AUTH_AUTHORITY=https://flowlee.eu.auth0.com

# Auth0 application client ID
VITE_AUTH_CLIENT_ID=your-client-id-here

# Auth0 API audience identifier (same for all environments)
VITE_AUTH_AUDIENCE=https://api.flowlee.com

# Mock mode — set to "true" to run the app without backend services or auth.
# When active, all env vars above are optional.
# VITE_MOCK=true
